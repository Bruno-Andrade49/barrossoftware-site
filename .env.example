# Endereço público do site (usado nas metatags e no Open Graph).
# Na Vercel não precisa: o domínio de produção é detectado sozinho.
NEXT_PUBLIC_SITE_URL=https://barrossoftware.com.br

# Formulário de contato (envio por e-mail via Resend: https://resend.com)
RESEND_API_KEY=
CONTACT_TO=contato@barrossoftware.com.br
CONTACT_FROM="Site BarrosSoftware <site@barrossoftware.com.br>"

# Painel de projetos (CMS em /painel) — login fixo
# Senha com 12+ caracteres (o painel não liga com menos); de preferência 20+, gerada por um gerenciador.
ADMIN_USER=
ADMIN_PASSWORD=
# Segredo que assina o cookie da sessão: 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor desloga todo mundo.
ADMIN_SESSION_SECRET=

# Supabase (banco e arquivos dos projetos). Project Settings → API.
# A chave service_role só existe no servidor: nunca use prefixo NEXT_PUBLIC_ nela.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
