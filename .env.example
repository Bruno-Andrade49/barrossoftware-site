NEXT_PUBLIC_SITE_URL=https://barrossoftware.com.br

# Formulário de contato (envio por e-mail via Resend: https://resend.com)
RESEND_API_KEY=
CONTACT_TO=contato@barrossoftware.com.br
CONTACT_FROM="Site BarrosSoftware <site@barrossoftware.com.br>"
